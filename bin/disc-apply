#!/usr/bin/env python3
"""Apply the plan.json that disc-identify wrote.

disc-apply renames the kept titles and moves the rejected titles to
rejected/.

If you call disc-apply manually, each decision is written to plan.json so an
interrupted review can resume.

disc-run calls disc-apply --auto. This applies the plan if each item is high
confidence and no item is unknown. Otherwise, the disc is held for review.

disc-apply never deletes a file. --revert puts each file back.
"""

import argparse
import shutil
import subprocess
import sys
import textwrap
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from discpipe import drainer, manifest, notify, plan as planlib

MARK = {
    planlib.FEATURE: "*",
    planlib.EXTRA: "+",
    planlib.REJECT: "-",
    planlib.UNKNOWN: "?",
}


def main():
    parser = argparse.ArgumentParser(description="Review and apply a naming plan.")
    parser.add_argument("target", nargs="?", default=None,
                        help="queue slug or disc folder; defaults to the current directory")
    parser.add_argument("--yes", action="store_true",
                        help="accept every proposal without review")
    parser.add_argument("--auto", action="store_true",
                        help="accept only if every item is high confidence")
    parser.add_argument("--reset", action="store_true",
                        help="put the files back and review again")
    parser.add_argument("--revert", action="store_true",
                        help="put the files back under their original names")
    parser.add_argument("--dry-run", action="store_true",
                        help="show what would happen, change nothing")
    args = parser.parse_args()

    work_dir = planlib.resolve_target(args.target)
    name = slug = work_dir.name
    media_dir = work_dir / "raw"
    plan = planlib.load(work_dir)
    items = plan.get("items", [])
    if not items:
        notify.fail("the plan has no items")

    _suspect_warning(slug)

    if args.auto:
        blockers = _auto_blockers(items)
        if blockers:
            notify.say(f"\n{name}: not eligible for automatic naming.")
            for blocker in blockers[:8]:
                notify.say(f"  {blocker}")
            notify.say(f"Review it: disc-apply {slug}")
            manifest.hold(manifest.load(slug),
                          f"needs review: {len(blockers)} item(s) not eligible "
                          "for automatic naming", stage="apply")
            return 1
        notify.say(f"\n{name}: every item high confidence -- applying "
                   "without review.")
        plan["auto_applied"] = manifest.now()
        args.yes = True

    persist = not args.dry_run

    if args.revert or args.reset:
        undone = _revert(plan, media_dir, work_dir, args)
        if args.revert:
            notify.say(f"\nPut back {undone} file(s).")
            if persist:
                planlib.save(plan, work_dir)
            return 0
        for item in items:
            item.pop("decision", None)
            item.pop("applied", None)
        plan.pop("auto_applied", None)
        if persist:
            planlib.save(plan, work_dir)

    _summary(plan, name)

    if args.yes:
        for item in items:
            item.setdefault("decision", planlib.ACCEPT)
        if persist:
            planlib.save(plan, work_dir)
    elif planlib.pending(plan):
        if not _review(plan, work_dir, media_dir, persist):
            notify.say("Stopped. Decisions so far are saved.")
            return 0
    else:
        notify.say("Every item already reviewed. Re-run with --reset to start over.")

    moves, rejects, untouched = _resolve_actions(plan, media_dir, work_dir)
    if not _confirm(moves, rejects, untouched, args):
        return 0

    applied = _execute(moves, rejects, args.dry_run)
    if persist:
        planlib.save(plan, work_dir)
    if args.dry_run:
        notify.say(f"\nDry run -- {applied} change(s) not made.")
        return 0

    notify.say(f"\nApplied {applied} change(s).")
    manifest.advance_slug(slug, manifest.APPLIED)
    drainer.start()
    return 0


def _suspect_warning(slug):
    """MakeMKV reads around a sector that it cannot read, and still exits with 0."""
    data = manifest.load(slug)
    rip = data.get("rip", {})
    if not rip.get("suspect"):
        return
    if rip.get("verified"):
        notify.say("\nNote: this rip had read errors, but every affected title "
                   "was decode-checked and is clean.")
        return

    affected = [t for t in data.get("titles", [])
                if t.get("rip", {}).get("warnings")]
    notify.say("\n" + "!" * 60)
    notify.say("This rip had read errors that MakeMKV worked around.")
    for title in affected:
        notify.say(f"  title {title['index']}  {title['duration']}  "
                   f"{title['output_name']}  "
                   f"({len(title['rip']['warnings'])} error(s))")
    notify.say("")
    notify.say("Data was unreadable, so the file may glitch. Check before")
    notify.say("committing hours of transcode:")
    for title in affected:
        notify.say(f'  ffmpeg -v error -i "raw/{title["output_name"]}" -f null -')
    notify.say("Silence means it decodes cleanly.")
    notify.say("!" * 60)


def _auto_blockers(items):
    blockers = []
    for item in items:
        confidence = item.get("confidence", "low")
        if item.get("action") == planlib.UNKNOWN:
            blockers.append(f"unidentified: {item['file']}")
        elif confidence != "high":
            blockers.append(f"{confidence} confidence: {item['file']}")
    return blockers


def _revert(plan, media_dir, work_dir, args):
    reject_dir = work_dir / "rejected"
    moves = []
    for item in plan.get("items", []):
        original = media_dir / item["file"]
        if original.exists():
            continue
        applied = item.get("applied")
        candidates = [reject_dir / item["file"]]
        if applied:
            candidates.insert(0, media_dir / applied)
        elif item.get("new_name"):
            candidates.insert(0, media_dir / item["new_name"])
        for candidate in candidates:
            if candidate.exists():
                moves.append((candidate, original, item))
                break

    if not moves:
        notify.say("Nothing to put back.")
        return 0

    for source, target, _ in moves:
        notify.say(f"  back    {source.name}")
        notify.say(f"       -> {target.name}")
    if args.dry_run:
        return len(moves)

    done = 0
    for source, target, item in moves:
        if target.exists():
            notify.say(f"  ! {target.name} already exists, skipping")
            continue
        try:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(source), str(target))
        except OSError as exc:
            notify.say(f"  ! could not move {source.name}: {exc}")
            continue
        item.pop("applied", None)
        done += 1
    return done


def _summary(plan, name):
    notify.say(f"\n{plan.get('title', name)} ({plan.get('year', '?')})")
    notify.say(f"  {planlib.tally(plan)}")
    if plan.get("disc_notes"):
        notify.say("\n" + plan["disc_notes"])
    notify.not_ripped(plan.get("missing_from_rip"))


def _review(plan, work_dir, media_dir, persist=True):
    items = plan["items"]
    total = len(items)
    notify.say(
        "\n[enter] accept   e edit name   r reject   k keep as-is"
        "   f show frames   q quit\n"
    )

    for index, item in enumerate(items, 1):
        if item.get("decision"):
            continue
        while True:
            _show(item, index, total)
            try:
                choice = input("  > ").strip().lower()
            except (EOFError, KeyboardInterrupt):
                notify.say("")
                return False

            if choice in ("", "a", "y"):
                item["decision"] = planlib.ACCEPT
            elif choice == "r":
                item["decision"] = planlib.DECLINE
            elif choice == "k":
                item["decision"] = planlib.KEEP
            elif choice == "q":
                return False
            elif choice == "f":
                _open_frames(item, work_dir)
                continue
            elif choice == "e":
                edited = _edit(item)
                if edited is None:
                    continue
                item["new_name"] = edited
                item["decision"] = planlib.EDIT
                if item.get("action") not in (planlib.FEATURE, planlib.EXTRA):
                    item["action"] = planlib.EXTRA
            else:
                notify.say("  ? unrecognised")
                continue
            break
        if persist:
            planlib.save(plan, work_dir)
    return True


def _show(item, index, total):
    action = item.get("action", "?")
    proposed = item.get("new_name") or f"({action})"
    notify.say(f"[{index}/{total}] {item['file']}")
    notify.say(f"   {MARK.get(action, ' ')} {proposed}   [{action}, "
               f"{item.get('confidence', '?')}]")
    for line in textwrap.wrap(item.get("evidence", ""), 92) or [""]:
        notify.say(f"     {line}")



def _edit(item):
    notify.say("   New filename (blank to cancel). Extras end in -<type>.mkv,")
    notify.say("   one of: behindthescenes deleted featurette interview scene "
               "short trailer other")
    try:
        value = input("   name> ").strip()
    except (EOFError, KeyboardInterrupt):
        return None
    if not value:
        return None
    if not value.endswith(".mkv"):
        value += ".mkv"
    return value


def _open_frames(item, work_dir):
    stem = Path(item["file"]).stem
    sheets = [work_dir / "frames" / f"{stem}--{kind}.png" for kind in ("head", "scan")]
    found = [s for s in sheets if s.exists()]
    if not found:
        notify.say("   (no contact sheets for this file)")
        return
    subprocess.run(["open", *[str(s) for s in found]], check=False)


def _resolve_actions(plan, media_dir, work_dir):
    moves, rejects, untouched = [], [], []
    reject_dir = work_dir / "rejected"

    for item in plan["items"]:
        source = media_dir / item["file"]
        action, new_name = planlib.outcome(item)

        if action in (planlib.FEATURE, planlib.EXTRA) and new_name:
            target = media_dir / new_name
            if source.name == target.name:
                untouched.append((item["file"], "already named"))
            else:
                moves.append((source, target, item))
        elif action == planlib.REJECT:
            rejects.append((source, reject_dir / item["file"], item))
        else:
            untouched.append((item["file"], action))
    return moves, rejects, untouched


def _confirm(moves, rejects, untouched, args):
    notify.say("")
    for source, target, _ in moves:
        notify.say(f"  rename  {source.name}")
        notify.say(f"       -> {target.name}")
    for source, _, _ in rejects:
        notify.say(f"  aside   {source.name}")
    for filename, why in untouched:
        notify.say(f"  leave   {filename}  ({why})")

    problems = _preflight(moves, rejects)
    if problems:
        notify.say("")
        for problem in problems:
            notify.say(f"  ! {problem}")
        notify.fail("nothing applied")

    if not moves and not rejects:
        notify.say("\nNothing to do.")
        return False
    if args.yes or args.dry_run:
        return True
    try:
        return input(f"\nApply {len(moves)} rename(s), "
                     f"{len(rejects)} set aside? [y/N] ").strip().lower() == "y"
    except (EOFError, KeyboardInterrupt):
        notify.say("")
        return False


def _preflight(moves, rejects):
    problems = []
    claimed = {}
    for source, target, _ in moves + rejects:
        if not source.exists():
            problems.append(f"missing: {source.name}")
        if target.exists():
            problems.append(f"target exists: {target}")
        if target in claimed:
            problems.append(f"two files want the name {target.name}")
        claimed[target] = source
    return problems


def _execute(moves, rejects, dry_run):
    count = 0
    for source, target, item in moves:
        if not dry_run:
            source.rename(target)
            item["applied"] = target.name
        count += 1
    for source, target, item in rejects:
        if not dry_run:
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(source), str(target))
            item["applied"] = None
        count += 1
    return count


if __name__ == "__main__":
    raise SystemExit(main())
