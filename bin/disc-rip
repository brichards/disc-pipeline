#!/usr/bin/env python3
"""Stage 01 -- scan the drive, triage the titles, rip what's worth keeping.

Rips everything over the minimum length rather than trying to pick extras
here. Nothing on this side of the rip can tell a featurette from a slice of
the feature: that needs title cards and runtimes, which is disc-identify's
job. Pruning happens after naming, before transcoding, so no CPU is spent on
titles that turn out to be junk.
"""

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from discpipe import config, disc, locks, makemkv, manifest, notify, probe, triage


def main():
    parser = argparse.ArgumentParser(description="Rip a disc into the queue.")
    parser.add_argument("--disc", type=int, default=0, help="MakeMKV drive index")
    parser.add_argument("--force", action="store_true", help="re-rip a known disc")
    parser.add_argument("--dry-run", action="store_true", help="scan and triage only")
    parser.add_argument("--redo", action="store_true",
                        help="re-rip titles already marked done")
    parser.add_argument("--no-eject", action="store_true",
                        help="leave the disc in the drive when the rip is clean")
    parser.add_argument("--wait", action="store_true",
                        help="block for the drive lock instead of stepping aside")
    args = parser.parse_args()

    try:
        config.check_environment()
    except EnvironmentError as exc:
        notify.alert("Rip cannot start", str(exc))
        notify.fail(str(exc))

    discs = disc.find_discs()
    if not discs:
        notify.fail("no Blu-ray or DVD found in /Volumes")

    # One drive, one reader. A watcher that fires while a rip is running must
    # step aside rather than fight for the disc.
    try:
        with locks.hold(locks.DRIVE, blocking=args.wait):
            return _run(args, discs)
    except locks.Busy as exc:
        notify.say(f"{exc} -- another rip is in progress.")
        return 0


def _run(args, discs):
    mount, kind = discs[0]
    notify.say(f"Found {kind} at {mount}")

    fingerprint = disc.fingerprint(mount, kind)
    label = mount.name
    slug = disc.slugify(label, fingerprint)

    seen = manifest.ledger_find(fingerprint)
    if seen and not args.force:
        notify.say(
            f"Already ripped {seen.get('first_seen', '?')}"
            f" as {seen.get('shipped_as') or seen.get('slug')}."
            f" Use --force to rip again."
        )
        _eject(mount, args)
        return 0

    config.ensure_root()
    try:
        data = manifest.load(slug)
    except (OSError, ValueError):
        data = manifest.new(slug, fingerprint, label, kind)
        manifest.save(data)

    min_length = config.MIN_TITLE_LENGTH

    notify.say(f"Scanning titles (minimum {min_length}s)...")
    info, raw = makemkv.scan(args.disc, min_length)
    if not info.titles:
        manifest.hold(data, "makemkvcon returned no titles")
        notify.alert("Rip held", f"{label}: no titles returned")
        return 1

    logs = manifest.subdir(slug, "logs")
    (logs / "scan.txt").write_text(raw, encoding="utf-8")

    candidates = [t for t in info.titles if t.seconds >= min_length]
    data["titles"] = _merge_titles(data.get("titles", []), candidates)
    data["triage"] = triage.summarize(info.titles, min_length)
    manifest.save(data)

    _report(candidates, data["triage"])

    if data["triage"]["obfuscated"]:
        override = manifest.overrides_load().get(fingerprint)
        if override:
            wanted = override["playlist"]
            picked = [t for t in candidates if t.source_file == wanted]
            if not picked:
                manifest.hold(data, f"override names {wanted}, not on this disc")
                notify.alert("Rip held", f"{label}: override {wanted} not found")
                return 1
            notify.say(f"Override: ripping {wanted} only")
            candidates = picked
        else:
            reason = (
                f"{data['triage']['decoy_cluster_size']} near-identical "
                f"feature-length titles; correct playlist unknown"
            )
            manifest.hold(data, reason)
            notify.alert("Rip held", f"{label}: {reason}")
            notify.say("Resolve with: disc-resolve " + slug)
            return 1

    raw_dir = manifest.subdir(slug, "raw")
    records = {r["source_file"]: r for r in data["titles"]}
    todo, have = _split_todo(candidates, records, raw_dir, args.redo)
    if not args.dry_run:  # a dry run reports; it records nothing
        manifest.save(data)

    for title in have:
        notify.say(f"  have  title {title.index}  ({title.output_name})")
    for title in todo:
        notify.say(f"  rip   title {title.index}  {title.duration}  "
                   f"{notify.human_bytes(title.size_bytes)}")

    if not todo:
        notify.say("\nEverything on this disc is already ripped.")
        return _finish(data, label, kind, slug, fingerprint, raw_dir,
                       0, 0, len(have), mount, args)

    needed = disc.estimated_bytes(todo) + config.SPACE_HEADROOM_BYTES
    available = disc.free_bytes(config.ROOT)
    notify.say(
        f"Need {notify.human_bytes(needed)}, "
        f"{notify.human_bytes(available)} free"
    )
    if available < needed:
        reason = (
            f"needs {notify.human_bytes(needed)}, "
            f"{notify.human_bytes(available)} free"
        )
        manifest.hold(data, reason, retryable=True, stage="rip")
        notify.alert("Rip held", f"{label}: {reason}")
        notify.say("Free some space and run disc-rip again -- "
                   "the disc is still in the drive.")
        return 1

    if args.dry_run:
        notify.say("Dry run -- stopping before the rip.")
        return 0

    done = failed = 0

    # One damaged segment should not cost the rest of the disc. The disc is in
    # the drive now; putting it back later is the expensive part. So a failure
    # is recorded against its title and the run moves on.
    for title in todo:
        record = records[title.source_file]
        output = raw_dir / title.output_name
        notify.say(
            f"Ripping title {title.index} "
            f"({title.duration}, {notify.human_bytes(title.size_bytes)})"
        )
        code, trouble, transcript = makemkv.rip(
            args.disc, title.index, raw_dir, min_length
        )
        ok = code == 0 and output.exists()
        mismatch = ok and not _duration_matches(output, title.seconds)
        if mismatch:
            # The output is not the title that was asked for. Never let this
            # pass: a wrong-but-plausible file is worse than a missing one.
            ok = False
        record["rip"] = {
            "status": "done" if ok else "failed",
            "exit_code": code,
            "output": output.name,
            "warnings": trouble,
            "at": manifest.now(),
        }
        if mismatch:
            record["rip"]["error"] = (
                f"output runs {probe.ffprobe(output)['duration']}, "
                f"expected {title.duration}"
            )
        manifest.save(data)

        if ok:
            done += 1
            if trouble:
                notify.say(f"  ! {len(trouble)} read problem(s) worked around")
        else:
            failed += 1
            (logs / f"rip-title-{title.index:02d}.log").write_text(
                transcript, encoding="utf-8"
            )
            detail = record["rip"].get("error") or f"exit {code}"
            notify.say(f"  ! failed ({detail}) -- continuing")

    return _finish(data, label, kind, slug, fingerprint, raw_dir,
                   done, failed, len(have), mount, args)


# A ripped title is checked by its runtime, never by its size. Size was tried
# first and silently accepted files containing the wrong title, because extras
# on one disc land within a few percent of each other.
#
# 1.5s: MakeMKV reports whole seconds, so a correct rip lands under a second
# out (measured: 0.50s and 0.86s on known-good files). Anything beyond that is
# a different title.
#
# This is a tripwire, not a proof. Warm Bodies has two extras 2 seconds apart,
# which no tolerance can separate. The real guarantee is that the rip and the
# scan now enumerate identically, so the indices cannot drift in the first
# place.
DURATION_TOLERANCE = 1.5


def _duration_matches(path, expected_seconds):
    info = probe.ffprobe(path)
    if not info or not expected_seconds:
        return False
    return abs(info["seconds"] - expected_seconds) <= DURATION_TOLERANCE


def _split_todo(candidates, records, raw_dir, redo):
    """Decide what still needs ripping, and adopt anything already on disk.

    A manifest written before per-title status existed -- or one interrupted
    hard enough to lose it -- still has the finished files sitting in raw/.
    Rather than re-rip an hour of video, adopt an output that is present and
    close enough to its expected size, and record it.
    """
    todo, have = [], []
    for title in candidates:
        record = records[title.source_file]
        output = raw_dir / title.output_name
        status = record.get("rip", {}).get("status")

        if not redo and status == "done" and output.exists():
            have.append(title)
            continue

        if not redo and status != "failed" and output.exists():
            if _duration_matches(output, title.seconds):
                record["rip"] = {
                    "status": "done",
                    "exit_code": 0,
                    "output": output.name,
                    "warnings": [],
                    "at": manifest.now(),
                    "adopted": True,
                }
                have.append(title)
                continue
        todo.append(title)
    return todo, have


def _merge_titles(previous, candidates):
    """Rebuild the title list from a fresh scan without losing rip status.

    Keyed on the source playlist rather than the index, because MakeMKV's
    numbering is not guaranteed stable across scans.
    """
    kept = {r.get("source_file"): r.get("rip") for r in previous if r.get("rip")}
    records = []
    for title in candidates:
        record = _title_record(title)
        if title.source_file in kept:
            record["rip"] = kept[title.source_file]
        records.append(record)
    return records


def _eject(mount, args):
    """Only on a clean run. A disc with failures or worked-around read errors
    stays in the drive, because the next thing to try is cleaning it and going
    again -- and that is easier with the disc where it is."""
    if args.no_eject or args.dry_run:
        return
    if disc.eject(mount):
        notify.say(f"Ejected {mount.name}")
    else:
        notify.say(f"Could not eject {mount.name}")


def _finish(data, label, kind, slug, fingerprint, raw_dir,
            done, failed, skipped, mount, args):
    warnings = [w for r in data["titles"] for w in r.get("rip", {}).get("warnings", [])]
    data["rip"]["warnings"] = warnings
    data["rip"]["ripped_at"] = manifest.now()
    data["rip"]["exit_code"] = 0 if not failed else 1

    notify.say(
        f"\n{done} ripped, {skipped} already had, {failed} failed"
        + (f", {len(warnings)} read problem(s) worked around" if warnings else "")
    )

    if failed:
        broken = [r["index"] for r in data["titles"]
                  if r.get("rip", {}).get("status") == "failed"]
        reason = f"{failed} title(s) failed: {', '.join(str(b) for b in broken)}"
        manifest.hold(data, reason)
        notify.alert("Rip incomplete", f"{label}: {reason}")
        notify.say("Re-run disc-rip to retry only the failed titles.")
        notify.say("Disc left in the drive.")
        return 1

    _record_in_ledger(data, label, kind, slug, fingerprint)

    # A clean exit code is not a clean rip. MakeMKV retries a bad sector, works
    # around it, and still returns zero -- leaving a glitched file and no error.
    if warnings:
        data["rip"]["suspect"] = True
        manifest.advance(data, manifest.RIPPED)
        notify.alert(
            "Rip finished with warnings",
            f"{label}: {len(warnings)} read problem(s) -- check the tail",
        )
        notify.say("Disc left in the drive -- try cleaning it and re-ripping.")
        return 0

    manifest.advance(data, manifest.RIPPED)
    notify.say(f"Ripped to {raw_dir}")
    _eject(mount, args)
    return 0


def _record_in_ledger(data, label, kind, slug, fingerprint):
    if manifest.ledger_find(fingerprint):
        return
    manifest.ledger_append({
        "fingerprint": fingerprint,
        "label": label,
        "disc_type": kind,
        "slug": slug,
        "first_seen": data["created"],
        "shipped_as": None,
    })


def _title_record(title):
    return {
        "index": title.index,
        "duration": title.duration,
        "seconds": title.seconds,
        "chapters": title.chapters,
        "size_bytes": title.size_bytes,
        "source_file": title.source_file,
        "segment_map": title.segment_map,
        "output_name": title.output_name,
        "resolution": title.resolution,
        "audio_tracks": len(title.audio),
        "subtitle_tracks": len(title.subtitles),
        "state": "ripped",
    }


def _report(titles, summary):
    notify.say(
        f"{summary['titles_seen']} titles, "
        f"{len(titles)} over the minimum, "
        f"longest {notify.human_duration(summary['longest_seconds'])}"
    )
    if summary["obfuscated"]:
        notify.say(
            f"Decoy cluster: {summary['decoy_cluster_size']} near-identical titles "
            f"(order consistency {summary['segment_order_consistency']})"
        )
    # On an obfuscated disc the listing is noise -- 130 near-identical rows
    # tell you nothing that the cluster line above didn't.
    limit = 5 if summary["obfuscated"] else 40
    for title in titles[:limit]:
        notify.say(
            f"  {title.index:>3}  {title.duration:>9}  {title.chapters:>3}ch  "
            f"{notify.human_bytes(title.size_bytes):>9}  {title.source_file}"
        )
    if len(titles) > limit:
        notify.say(f"  ... {len(titles) - limit} more")


if __name__ == "__main__":
    raise SystemExit(main())
