#!/usr/bin/env python3
"""Decode each title with read errors, and find out whether it is damaged.

disc-verify runs after disc-rip and before disc-identify, so that no agent run
is spent on a damaged rip. It exits at once when no title needs a check.

If a title does not decode, the disc is held and ejected. If each title
decodes, the rip is marked verified and the disc is ejected. With --force,
disc-verify also accepts a title that failed only its duration check, if it
decodes clean.
"""

import argparse
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from discpipe import disc, drainer, locks, manifest, notify, plan as planlib, probe, verify


def main():
    parser = argparse.ArgumentParser(description="Decode-check a suspect rip.")
    parser.add_argument("target", nargs="?", default=None,
                        help="queue slug or disc folder; defaults to the current directory")
    parser.add_argument("--all", action="store_true",
                        help="check every title, not only the ones with read errors")
    parser.add_argument("--redo", action="store_true",
                        help="re-check titles already verified")
    parser.add_argument("--wait", action="store_true",
                        help="block for the CPU lock instead of stepping aside")
    parser.add_argument("--no-eject", action="store_true",
                        help="leave the disc in the drive even once it verifies")
    parser.add_argument("--force", action="store_true",
                        help="decode titles whose rip failed only its duration "
                             "check, and accept those that decode clean")
    args = parser.parse_args()

    work_dir = planlib.resolve_target(args.target)
    name = slug = work_dir.name
    media_dir = work_dir / "raw"
    try:
        data = manifest.load(slug)
    except (OSError, ValueError) as exc:
        notify.fail(f"cannot read the manifest: {exc}")

    if args.force:
        titles = _overridable(data, media_dir)
        if not titles:
            notify.say(f"{name}: no title failed only its duration check.")
            return 0
        try:
            with locks.hold(locks.CPU, blocking=args.wait):
                return _accept(data, name, titles)
        except locks.Busy as exc:
            notify.say(f"{exc} -- try again when it is free.")
            return 1

    titles = _to_check(data, media_dir, args)
    if not titles:
        if data.get("rip", {}).get("suspect"):
            notify.say(f"{name}: already verified.")
        return 0

    try:
        with locks.hold(locks.CPU, blocking=args.wait):
            return _verify(data, slug, name, titles, args)
    except locks.Busy as exc:
        notify.say(f"{exc} -- leaving this for the next pass.")
        return 0


def _to_check(data, media_dir, args):
    out = []
    for title in data.get("titles", []):
        rip = title.get("rip", {})
        if rip.get("status") != "done":
            continue
        if not args.all and not rip.get("warnings"):
            continue
        if not args.redo and title.get("verify", {}).get("status"):
            continue
        path = media_dir / title.get("output_name", "")
        if path.exists():
            out.append((title, path))
    return out


def _verify(data, slug, name, titles, args):
    notify.say(f"\n{name}: decode-checking {len(titles)} title(s)")
    failures = 0

    for title, path in titles:
        info = probe.ffprobe(path)
        offsets = verify.read_error_offsets(title.get("rip", {}).get("warnings"))
        if offsets and info:
            stamps = verify.approximate_times(offsets, info["size_bytes"],
                                              info["seconds"])
            window = f"{verify.hms(min(stamps))}-{verify.hms(max(stamps))}"
            notify.say(f"  title {title['index']}  {path.name}")
            notify.say(f"    {len(offsets)} unreadable region(s), roughly {window}")
        else:
            notify.say(f"  title {title['index']}  {path.name}")

        ok, errors, elapsed = _decode(title, path)
        manifest.save(data)

        if ok:
            notify.say(f"    decodes clean ({elapsed // 60}m{elapsed % 60:02d}s)")
        else:
            failures += 1
            notify.say(f"    {len(errors)} decode error(s) in {elapsed // 60}m"
                       f"{elapsed % 60:02d}s:")
            for line in errors[:5]:
                notify.say(f"      {line}")

    if failures:
        reason = f"{failures} title(s) will not decode cleanly"
        manifest.hold(data, reason, retryable=False, stage="rip")
        notify.alert("Rip verification failed", f"{name}: {reason}")
        notify.say("\nClean the disc, reinsert it, and re-rip the affected "
                   "title(s) with: disc-rip --redo")
        if not args.no_eject:
            _eject_if_still_ours(data)
        return 1

    data["rip"]["verified"] = True
    manifest.save(data)
    drainer.start()
    notify.say(f"\n{name}: verified -- every checked title decodes cleanly.")

    if not args.no_eject:
        _eject_if_still_ours(data)
    return 0


def _decode(title, path):
    started = time.time()
    ok, errors = verify.decode(path)
    elapsed = int(time.time() - started)
    title["verify"] = {
        "status": "clean" if ok else "errors",
        "errors": errors[:20],
        "error_count": len(errors),
        "seconds": elapsed,
        "at": manifest.now(),
    }
    return ok, errors, elapsed


def _overridable(data, media_dir):
    """A title that MakeMKV failed can be cut short.

    ffmpeg can decode a cut-short file with no error.
    """
    out = []
    for title in data.get("titles", []):
        rip = title.get("rip", {})
        path = media_dir / title.get("output_name", "")
        if (rip.get("status") == "failed"
                and str(rip.get("error", "")).startswith("output runs")
                and path.exists()):
            out.append((title, path))
    return out


def _accept(data, name, titles):
    notify.say(f"\n{name}: decode-checking {len(titles)} title(s) that failed "
               "their duration check")
    for title, path in titles:
        rip = title["rip"]
        notify.say(f"  title {title['index']}  {path.name}  ({rip['error']})")
        ok, errors, elapsed = _decode(title, path)
        if ok:
            rip["accepted"] = {"at": manifest.now(), "overrode": rip.pop("error")}
            rip["status"] = "done"
            notify.say(f"    decodes clean ({elapsed // 60}m{elapsed % 60:02d}s) "
                       "-- accepted")
        else:
            notify.say(f"    {len(errors)} decode error(s) -- still failed")
        manifest.save(data)

    if any(t.get("rip", {}).get("status") == "failed" for t in data["titles"]):
        notify.say(f"\n{name}: still held -- some titles are still failed.")
        return 1

    data["rip"]["suspect"] = any(t.get("rip", {}).get("warnings")
                                 for t in data["titles"])
    manifest.advance(data, manifest.RIPPED)
    drainer.start()
    notify.say(f"\n{name}: every title accepted -- ripped.")
    return 0


def _eject_if_still_ours(data):
    for mount, kind in disc.find_discs():
        try:
            if disc.fingerprint(mount, kind) != data.get("fingerprint"):
                continue
        except (OSError, ValueError):
            continue
        notify.ejected(mount, disc.eject(mount))
        return


if __name__ == "__main__":
    raise SystemExit(main())
