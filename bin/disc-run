#!/usr/bin/env python3
"""Start the next stage of each disc that is ready.

disc-run reads the state in each manifest. It starts the next stage of a disc
if the resource that the stage needs is free, then exits without a wait for
the stages. Stages do not call each other: each stage records the new state of
its disc, and disc-run starts the next one.

With --watch, disc-run keeps the Mac awake and repeats the pass until nothing
runs or starts for the grace period. A disc held for space, the NAS or the
agent is retried every 10 minutes, and keeps the session open.
"""

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from discpipe import config, disc, drainer, locks, manifest, notify

BIN = Path(__file__).resolve().parent

ACTIONS = {
    manifest.QUEUED: ("disc-rip", locks.DRIVE),
    manifest.RIPPED: ("disc-identify", locks.AGENT),
    manifest.APPLIED: ("disc-transcode", locks.CPU),
    manifest.TRANSCODED: ("disc-ship", locks.NET),
}

RETRY = {
    "rip": ("disc-rip", locks.DRIVE),
    "identify": ("disc-identify", locks.AGENT),
    "transcode": ("disc-transcode", locks.CPU),
    "ship": ("disc-ship", locks.NET),
}

GATES = (manifest.SHIPPED, manifest.DONE)

UNATTENDED = {
    "disc-apply": ["--auto"],
    "disc-transcode": ["--quiet"],
}

AUTO_APPLY_ACTION = ("disc-apply", locks.CPU)

IDLE_GRACE = 120
RETRY_INTERVAL = 600


def main():
    parser = argparse.ArgumentParser(description="Advance the queue.")
    parser.add_argument("--watch", action="store_true",
                        help="keep polling until nothing is left to advance")
    parser.add_argument("--interval", type=int, default=config.POLL_INTERVAL,
                        help="seconds between passes in watch mode")
    parser.add_argument("--grace", type=int, default=IDLE_GRACE,
                        help="seconds idle before a watch session exits")
    parser.add_argument("--dry-run", action="store_true",
                        help="report what would start, start nothing")
    args = parser.parse_args()

    try:
        with locks.hold(locks.SESSION):
            return _session(args)
    except locks.Busy:
        notify.say("A session is already running.")
        return 0


def _session(args):
    running = {}
    failed = {}
    tried = {}
    keep_awake = None
    idle_since = None

    if args.watch and not args.dry_run:
        keep_awake = _caffeinate()
        notify.say(f"Session started; polling every {args.interval}s.")

    try:
        while True:
            _reap(running, failed)
            started, waiting = _pass(running, failed, tried, args)
            if not args.watch:
                return 0

            if running or started or waiting:
                idle_since = None
            else:
                idle_since = idle_since or time.time()
                if time.time() - idle_since >= args.grace:
                    notify.say("Nothing left to advance. Session ending.")
                    return 0
            time.sleep(args.interval)
    except KeyboardInterrupt:
        notify.say("\nStopped. Anything already running keeps going.")
        return 0
    finally:
        if keep_awake:
            keep_awake.terminate()


def _pass(running, failed, tried, args):
    busy = {resource for _, resource, _ in running.values()}
    busy |= {r for r in (locks.DRIVE, locks.CPU, locks.NET, locks.AGENT)
             if r not in busy and not locks.is_free(r)}
    started = waiting = 0

    if locks.DRIVE not in busy:
        slug = _unqueued_disc()
        if slug and _launch(running, slug, "disc-rip", locks.DRIVE, [slug], args):
            busy.add(locks.DRIVE)
            started += 1

    for data in manifest.all_discs():
        slug = data.get("slug")
        if not slug or slug in running:
            continue
        stage, resource = _next_action(data)
        if not stage:
            continue
        state = data.get("state")
        if state == manifest.HELD:
            waiting += 1
            if time.time() - tried.get(slug, 0) < RETRY_INTERVAL:
                continue
        elif failed.get(slug) == (stage, state):
            continue
        if resource in busy:
            continue
        extra = [slug, *UNATTENDED.get(stage, ())]
        if _launch(running, slug, stage, resource, extra, args):
            busy.add(resource)
            started += 1
            if state == manifest.HELD:
                tried[slug] = time.time()
    return started, waiting


def _next_action(data):
    state = data.get("state")
    if state == manifest.IDENTIFIED:
        return AUTO_APPLY_ACTION
    if state in GATES:
        return None, None

    rip = data.get("rip", {})
    if state == manifest.RIPPED and rip.get("suspect") and not rip.get("verified"):
        return "disc-verify", locks.CPU
    if state == manifest.HELD:
        if not data.get("held_retryable"):
            return None, None
        return RETRY.get(data.get("held_stage", "rip"), (None, None))
    return ACTIONS.get(state, (None, None))


def _launch(running, slug, stage, resource, extra, args):
    label = slug if slug != "*drive*" else "new disc"
    if args.dry_run:
        notify.say(f"  would start  {stage:<15} {label}")
        return True

    notify.say(f"  starting  {stage:<15} {label}")
    log = config.ROOT / "watch.log"
    environment = dict(os.environ, DISC_LOG_PREFIX=f"[{slug}] ",
                       **{drainer.UNDER_DRAINER: "1"})
    try:
        with open(log, "a", encoding="utf-8") as handle:
            process = subprocess.Popen(
                [str(BIN / stage), *extra],
                stdout=handle, stderr=handle, stdin=subprocess.DEVNULL,
                start_new_session=True, env=environment,
            )
    except OSError as exc:
        notify.say(f"  ! could not start {stage}: {exc}")
        return False
    running[slug] = (stage, resource, process)
    return True


def _reap(running, failed):
    for slug in [s for s, (_, _, p) in running.items() if p.poll() is not None]:
        stage, _, process = running.pop(slug)
        label = slug if slug != "*drive*" else "new disc"
        if process.returncode != 0:
            notify.say(f"  {stage} for {label} exited {process.returncode}")
            data = manifest.find(slug)
            if data:
                failed[slug] = (stage, data.get("state"))


def _unqueued_disc():
    for mount, kind in disc.find_discs():
        try:
            fingerprint = disc.fingerprint(mount, kind)
        except (OSError, ValueError):
            continue
        if manifest.ledger_find(fingerprint):
            continue
        slug = disc.slugify(mount.name, fingerprint)
        if not (config.ROOT / slug / "manifest.json").exists():
            return slug
    return None


def _caffeinate():
    """caffeinate -i stops idle sleep, and -w ends it when this process exits."""
    try:
        return subprocess.Popen(
            ["caffeinate", "-i", "-w", str(os.getpid())],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
    except OSError:
        return None


if __name__ == "__main__":
    raise SystemExit(main())
